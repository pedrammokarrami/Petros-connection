# ==============================================================================
# AIGAMERIA Zero-Cost Personal Node & Backend Environment Configuration
# Copy to .env and fill in only the optional free integrations you want to enable.
# Never commit real secrets to version control.
# ==============================================================================

# Public URL of your personal node (used to mint custom server-branded /s/<slug> links)
APP_URL="http://localhost:3000"
NODE_PUBLIC_URL="http://localhost:3000"
PORT="3000"

# Operator control passphrase for Personal Server controls (/api/node/*, /api/streams/*, /api/upload/*)
# Leave empty to use the one-time first-run setup form in Settings -> Personal Server.
NODE_CONTROL_SECRET=""

# Optional encryption seed for the local SQLite metadata store (.aigameria-node/node-meta.sqlite)
NODE_STORAGE_KEY=""
SQLITE_DB_PATH=".aigameria-node/node-meta.sqlite"

# ==============================================================================
# P2P Networking, LAN Discovery & Optional Self-Hosted NAT Relay (STUN / TURN)
# ==============================================================================
LAN_DISCOVERY_ENABLED="true"
LAN_DISCOVERY_PORT="41234"
STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478"
# Optional free self-hosted coturn server (see docker-compose.yml --profile relay)
TURN_URL=""
TURN_SECRET=""

# ==============================================================================
# Telegram Bot Bridge & Automatic Server Failover Controller (Free Telegram API)
# ==============================================================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# Comma-separated numeric Telegram user/chat IDs authorized to control your node
TELEGRAM_ALLOWED_CHAT_IDS=""
# Use "polling" for home LAN machines without a public HTTPS domain, or "webhook" on a public domain
TELEGRAM_MODE="polling"

# ==============================================================================
# Zero-Server-Disk Free Cloud File Storage Adapters (All Optional)
# Temporary shares work out-of-the-box with zero keys via Litterbox & Tmpfiles.
# Permanent shares work out-of-the-box via Catbox, or add your free GitHub / IPFS keys below:
# ==============================================================================
# Option A: Free GitHub Releases permanent asset vault (repo format: "username/repo")
GITHUB_TOKEN=""
GITHUB_STORAGE_REPO=""
GITHUB_RELEASE_TAG="aigameria-vault"

# Option B: Free IPFS pinning via Pinata free tier OR self-hosted Kubo node (http://127.0.0.1:5001)
PINATA_JWT=""
IPFS_API_URL=""
IPFS_GATEWAY_URL="https://ipfs.io/ipfs"

# Option C: Optional Catbox account hash to manage your permanent Catbox uploads
CATBOX_USERHASH=""
